{
  "name": "DeepDive Research Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "deepdive-research",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.question }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "validate-request",
      "name": "Validate Request",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DEEPDIVE_BACKEND_URL }}/research",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "question",
              "value": "={{ $json.body.question }}"
            },
            {
              "name": "source_urls",
              "value": "={{ $json.body.source_urls || [] }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "start-research",
      "name": "Start Research Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DEEPDIVE_BACKEND_URL }}/runs/{{ $json.run_id }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "poll-status",
      "name": "Poll Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "leftValue": "={{ $json.state }}",
              "rightValue": "END",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "check-complete",
      "name": "Is Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "leftValue": "={{ $json.state }}",
              "rightValue": "FAILED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-failed",
      "name": "Is Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 360]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "leftValue": "={{ Date.now() - new Date($execution.startedAt).getTime() }}",
              "rightValue": 600000,
              "operator": { "type": "number", "operation": "gte" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-timeout",
      "name": "Is Timed Out?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1180, 420]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1000, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DEEPDIVE_BACKEND_URL }}/runs/{{ $('Start Research Run').item.json.run_id }}/report",
        "options": {}
      },
      "id": "get-report",
      "name": "Get Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DEEPDIVE_BACKEND_URL }}/runs/{{ $('Start Research Run').item.json.run_id }}/certificate",
        "options": {}
      },
      "id": "get-certificate",
      "name": "Get Certificate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'complete', report: $('Get Report').item.json, certificate: $('Get Certificate').item.json }) }}"
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1400, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'Missing required field: question' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [600, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'failed', run_id: $('Start Research Run').item.json.run_id, error: $json.error || 'Research run failed' }) }}",
        "options": { "responseCode": 500 }
      },
      "id": "respond-failed",
      "name": "Respond Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'timeout', run_id: $('Start Research Run').item.json.run_id, error: 'Research run exceeded 10 minute orchestration timeout' }) }}",
        "options": { "responseCode": 504 }
      },
      "id": "respond-timeout",
      "name": "Respond Timeout",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1380, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{"node": "Validate Request", "type": "main", "index": 0}]
      ]
    },
    "Validate Request": {
      "main": [
        [{"node": "Start Research Run", "type": "main", "index": 0}],
        [{"node": "Respond Error", "type": "main", "index": 0}]
      ]
    },
    "Start Research Run": {
      "main": [
        [{"node": "Poll Status", "type": "main", "index": 0}]
      ]
    },
    "Poll Status": {
      "main": [
        [{"node": "Is Complete?", "type": "main", "index": 0}]
      ]
    },
    "Is Complete?": {
      "main": [
        [{"node": "Get Report", "type": "main", "index": 0}, {"node": "Get Certificate", "type": "main", "index": 0}],
        [{"node": "Is Failed?", "type": "main", "index": 0}]
      ]
    },
    "Is Failed?": {
      "main": [
        [{"node": "Respond Failed", "type": "main", "index": 0}],
        [{"node": "Is Timed Out?", "type": "main", "index": 0}]
      ]
    },
    "Is Timed Out?": {
      "main": [
        [{"node": "Respond Timeout", "type": "main", "index": 0}],
        [{"node": "Wait", "type": "main", "index": 0}]
      ]
    },
    "Wait": {
      "main": [
        [{"node": "Poll Status", "type": "main", "index": 0}]
      ]
    },
    "Get Report": {
      "main": [
        [{"node": "Respond Success", "type": "main", "index": 0}]
      ]
    }
  },
  "pinData": {
    "Webhook": [
      {
        "json": {
          "body": {
            "question": "What are the main risks of investing in EV batteries in 2026?",
            "source_urls": []
          }
        }
      }
    ]
  },
  "settings": {
    "executionOrder": "v1"
  }
}
