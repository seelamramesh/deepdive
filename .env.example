# DeepDive Environment Configuration
# Copy to .env and fill in values

# Mesh API (mandatory - all LLM calls route through this)
MESH_API_KEY=rsk_your_key_here
MESH_MODEL=anthropic/claude-haiku-5.5
MESH_MAX_OUTPUT_TOKENS=4096
MESH_JSON_ATTEMPTS=2

# Optional autonomous web search (non-AI retrieval)
BRAVE_SEARCH_API_KEY=
DEEPDIVE_DB_PATH=/app/data/deepdive.db
MIN_SOURCE_TRUST=0.4

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Database (SQLite by default, set DATABASE_URL for PostgreSQL)
DATABASE_URL=sqlite:///deepdive.db

# Research defaults
MAX_RESEARCH_ROUNDS=3
MAX_SOURCES_PER_ROUND=10
MAX_SEARCH_QUERIES_PER_ROUND=2
MAX_CLAIMS=12
CONFIDENCE_THRESHOLD=0.7
REQUEST_TIMEOUT=30
